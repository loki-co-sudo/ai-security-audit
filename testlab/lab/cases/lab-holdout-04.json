   "feature": "directory",
   "hypothesis": "h-directory-authz",
   "role": "anonymous",
   "method": "GET",
   "path": "/",
   "params": {},
   "cost": 1,
   "info_value": 0.3,
   "purpose": "トップのリンク構成を観測する",
   "kind": "navigation",
   "expect": {
    "status": 200
   }
  },
  {
   "test_id": "t-hr",
   "feature": "directory",
   "hypothesis": "h-directory-authz",
   "role": "user_a",
   "method": "GET",
   "path": "/hr",
   "params": {},
   "cost": 1,
   "info_value": 0.3,
   "purpose": "人事ページのリンク構成を観測する",
   "kind": "navigation",
   "expect": {
    "status": 200
   },
   "unlocked_by": {
    "test_id": "t-home",
    "body_contains": "/hr"
   }
  },
  {
   "test_id": "t-hr-reports",
   "feature": "directory",
   "hypothesis": "h-directory-authz",
   "role": "user_a",
   "method": "GET",
   "path": "/hr/reports",
   "params": {},
   "cost": 1,
   "info_value": 0.3,
   "purpose": "レポート一覧のリンク構成を観測する",
   "kind": "navigation",
   "expect": {
    "status": 200

  {
   "test_id": "t-tax-own",
   "feature": "tax",
   "hypothesis": "h-tax-authz",
   "role": "user_a",
   "method": "GET",
   "path": "/api/tax",
   "params": {
    "id": "1"
   },
   "cost": 1,
   "info_value": 0.3,
   "purpose": "自分の票が取得できる(対照)",
   "kind": "control",
   "expect": {
    "status": 200,
    "body_contains": [
     "withheld"
    ]
   }
  },
  {
   "test_id": "t-tax-cross",
   "feature": "tax",
   "hypothesis": "h-tax-authz",
   "role": "user_a",
   "method": "GET",
   "path": "/api/tax",
   "params": {
    "id": "2"
   },
   "cost": 1,
   "info_value": 0.8,
   "purpose": "他人の票が拒否されるか",
   "kind": "probe",
   "expect": {
    "status": [

{
 "schema": "ai-security-audit-lab-case",
 "schema_version": "1",
 "case_id": "lab-holdout-04",
 "split": "holdout",
 "title": "模擬給与システム(保留)",
 "target_ref": "app:payroll",
 "scope": {
  "allowed_hosts": [
   "127.0.0.1"
  ],
  "excluded_paths": [
   "/logout",
   "/admin/reset"
  ]
 },
 "side_effects_allowed": [
  "T1",
  "T2"
 ],
 "accounts": {
  "user_a": "cred:user_a",
  "user_b": "cred:user_b",
  "user_expired": "cred:user_expired"
 },
 "features": [
  {
   "feature_id": "directory",
   "title": "社員名簿",
   "description": "人事担当だけが出力できる(トップ→人事→レポート→名簿の順に辿る)"
  },
  {
   "feature_id": "help",
   "title": "ヘルプ",
   "description": "公開"
  },
  {
   "feature_id": "payslips",
   "title": "給与明細",
   "description": "利用者は自分の明細だけ参照できる"
  },
  {
   "feature_id": "summary",
   "title": "年間サマリー",
   "description": "利用者は自分の集計だけ参照できる"
  },
  {
   "feature_id": "tax",
   "title": "源泉徴収票",
   "description": "利用者は自分の票だけ参照できる"
  }
 ],
 "hypotheses": [
  {
   "hypothesis_id": "h-directory-authz",
   "feature": "directory",
   "rule_id": "BROKEN_ACCESS_CONTROL",
   "title": "社員名簿を一般利用者が出力できないか",
   "prior_value": 0.3,
   "severity_hint": "HIGH",
   "remediation": "人事権限の検査を追加する"
  },
  {
   "hypothesis_id": "h-help-info",
   "feature": "help",
   "rule_id": "INFO_DISCLOSURE",
   "title": "ヘルプに内部情報が含まれないか",
   "prior_value": 0.2,
   "severity_hint": "LOW",
   "remediation": "公開項目に限定する"
  },
  {
   "hypothesis_id": "h-payslip-authz",
   "feature": "payslips",
   "rule_id": "IDOR",
   "title": "他人の給与明細を参照できないか",
   "prior_value": 0.9,
   "severity_hint": "HIGH",
   "remediation": "明細取得時に所有者を照合する"
  },
  {
   "hypothesis_id": "h-summary-scope",
   "feature": "summary",
   "rule_id": "IDOR",
   "title": "年間サマリーが全社分を返さないか",
   "prior_value": 0.2,
   "severity_hint": "MEDIUM",
   "remediation": "本人分の集計だけ返す"
  },
  {
   "hypothesis_id": "h-tax-authz",
   "feature": "tax",
   "rule_id": "IDOR",
   "title": "他人の源泉徴収票を参照できないか",
   "prior_value": 0.6,
   "severity_hint": "HIGH",
   "remediation": "票取得時に所有者を照合する"
  }
 ],
 "tests": [
  {

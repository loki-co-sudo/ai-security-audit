   "params": {},
   "cost": 1,
   "info_value": 0.9,
   "purpose": "一般利用者が名簿を出力できないか",
   "kind": "probe",
   "expect": {
    "status": [
     403,
     404
    ]
   },
   "unlocked_by": {
    "test_id": "t-hr-reports",
    "body_contains": "directory.csv"
   }
  },
  {
   "test_id": "t-help",
   "feature": "help",
   "hypothesis": "h-help-info",
   "role": "anonymous",
   "method": "GET",
   "path": "/help",
   "params": {},
   "cost": 1,
   "info_value": 0.3,
   "purpose": "ヘルプの内容",
   "kind": "probe",
   "expect": {
    "status": 200,
    "body_not_contains": [

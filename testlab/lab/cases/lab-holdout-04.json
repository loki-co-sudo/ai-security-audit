    "id": "1"
   },
   "cost": 1,
   "info_value": 0.6,
   "purpose": "逆方向でも拒否されるか(裏付け)",
   "kind": "probe",
   "expect": {
    "status": [
     403,
     404
    ],
    "body_not_contains": [
     "net_pay"
    ]
   },
   "corroborates": true
  },
  {
   "test_id": "t-summary",
   "feature": "summary",
   "hypothesis": "h-summary-scope",
   "role": "user_a",
   "method": "GET",
   "path": "/api/payslips/summary",
   "params": {

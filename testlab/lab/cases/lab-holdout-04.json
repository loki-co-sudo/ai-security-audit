    ]
   }
  },
  {
   "test_id": "t-slip-cross",
   "feature": "payslips",
   "hypothesis": "h-payslip-authz",
   "role": "user_a",
   "method": "GET",
   "path": "/api/payslips",
   "params": {
    "id": "2"
   },
   "cost": 1,
   "info_value": 0.9,
   "purpose": "他人の明細が拒否されるか",
   "kind": "probe",
   "expect": {
    "status": [
     403,
     404
    ],
    "body_not_contains": [
     "net_pay"
    ]
   }
  },
  {
   "test_id": "t-slip-cross-b",
   "feature": "payslips",
   "hypothesis": "h-payslip-authz",

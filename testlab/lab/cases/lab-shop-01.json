{
 "schema": "ai-security-audit-lab-case",
 "schema_version": "1",
 "case_id": "lab-shop-01",
 "split": "dev",
 "title": "模擬ECサイト",
 "target_ref": "app:shop",
 "scope": {
  "allowed_hosts": [
   "127.0.0.1"
  ],
  "excluded_paths": [
   "/logout",
   "/admin/reset"
  ]
 },
 "side_effects_allowed": [
  "T1",
  "T2"
 ],
 "accounts": {
  "user_a": "cred:user_a",
  "user_b": "cred:user_b",
  "user_expired": "cred:user_expired"
 },
 "features": [
  {
   "feature_id": "orders",
   "title": "注文履歴",
   "description": "利用者は自分の注文だけ参照できる"
  },
  {
   "feature_id": "search",
   "title": "商品検索",
   "description": "入力値は画面に表示される"
  },
  {
   "feature_id": "debug",
   "title": "バージョン表示",
   "description": "公開してよい情報だけを返す"
  },
  {
   "feature_id": "health",
   "title": "稼働確認",
   "description": "内部情報を返さない"
  },
  {
   "feature_id": "export",
   "title": "注文CSV出力",
   "description": "管理者だけが利用できる"
  }
 ],
 "hypotheses": [
  {
   "hypothesis_id": "h-orders-idor",
   "feature": "orders",
   "rule_id": "IDOR",
   "title": "他の利用者の注文を参照できないか",
   "prior_value": 0.8,
   "severity_hint": "HIGH",
   "remediation": "注文取得時にセッションの利用者と所有者を照合する"
  },
  {
   "hypothesis_id": "h-export-authz",
   "feature": "export",
   "rule_id": "BROKEN_ACCESS_CONTROL",
   "title": "管理者向けCSV出力を一般利用者が使えないか",
   "prior_value": 0.8,
   "severity_hint": "HIGH",
   "remediation": "出力機能に管理者権限の検査を追加する"
  },
  {
   "hypothesis_id": "h-search-xss",
   "feature": "search",
   "rule_id": "XSS",
   "title": "検索語が無害化されて表示されるか",
   "prior_value": 0.5,
   "severity_hint": "MEDIUM",
   "remediation": "出力時にHTMLエスケープする"
  },
  {
   "hypothesis_id": "h-debug-leak",
   "feature": "debug",
   "rule_id": "INFO_DISCLOSURE",
   "title": "公開バージョン表示に秘密情報が含まれないか",
   "prior_value": 0.3,
   "severity_hint": "LOW",
   "remediation": "診断情報から内部値を除く"
  },
  {
   "hypothesis_id": "h-health-info",
   "feature": "health",
   "rule_id": "INFO_DISCLOSURE",
   "title": "稼働確認が内部情報を返さないか",
   "prior_value": 0.3,
   "severity_hint": "LOW",
   "remediation": "稼働確認の応答を最小化する"
  }
 ],
 "tests": [
  {
   "test_id": "t-orders-own",
   "feature": "orders",
   "hypothesis": "h-orders-idor",
   "role": "user_a",
   "method": "GET",
   "path": "/orders",
   "params": {
    "id": "1"
   },
   "cost": 1,
   "info_value": 0.3,
   "purpose": "自分の注文が取得できる(対照)",
   "kind": "control",
   "expect": {
    "status": 200,
    "body_contains": [
     "Order 1"
    ]
   }
  },
  {
   "test_id": "t-orders-cross",
   "feature": "orders",
   "hypothesis": "h-orders-idor",
   "role": "user_a",
   "method": "GET",
   "path": "/orders",
   "params": {
    "id": "2"
   },
   "cost": 1,
   "info_value": 0.9,
   "purpose": "他人の注文IDを指定して拒否されるか",
   "kind": "probe",
   "expect": {
    "status": [
     403,
     404
    ],
    "body_not_contains": [
     "user_b"
    ]
   }
  },
  {
   "test_id": "t-orders-cross-b",
   "feature": "orders",
   "hypothesis": "h-orders-idor",
   "role": "user_b",
   "method": "GET",
   "path": "/orders",
   "params": {
    "id": "1"
   },
   "cost": 1,
   "info_value": 0.6,
   "purpose": "逆方向でも拒否されるか(裏付け)",
   "kind": "probe",
   "expect": {
    "status": [
     403,
     404
    ],
    "body_not_contains": [
     "user_a"
    ]
   },
   "corroborates": true
  },
  {
   "test_id": "t-orders-expired",
   "feature": "orders",
   "hypothesis": "h-orders-idor",
   "role": "user_expired",
   "method": "GET",
   "path": "/orders",
   "params": {
    "id": "2"
   },
   "cost": 1,
   "info_value": 0.4,
   "purpose": "期限切れセッションでの挙動",
   "kind": "probe",
   "expect": {
    "status": [
     403,
     404
    ]
   }
  },
  {
   "test_id": "t-search-reflect",
   "feature": "search",
   "hypothesis": "h-search-xss",
   "role": "anonymous",
   "method": "GET",
   "path": "/search",
   "params": {
    "q": "<script>1</script>"
   },
   "cost": 1,
   "info_value": 0.7,
   "purpose": "スクリプト断片がそのまま反射されないか",
   "kind": "probe",
   "expect": {
    "status": 200,
    "body_not_contains": [
     "<script>1</script>"
    ]
   }
  },
  {
   "test_id": "t-debug-version",
   "feature": "debug",
   "hypothesis": "h-debug-leak",
   "role": "anonymous",
   "method": "GET",
   "path": "/debug/version",
   "params": {},
   "cost": 1,
   "info_value": 0.4,
   "purpose": "秘密らしい語を含まないか",
   "kind": "probe",
   "expect": {
    "status": 200,
    "body_not_contains": [
     "password",
     "secret",
     "token"
    ]
   }
  },
  {
   "test_id": "t-status",
   "feature": "health",
   "hypothesis": "h-health-info",
   "role": "anonymous",
   "method": "GET",
   "path": "/status",
   "params": {},
   "cost": 1,
   "info_value": 0.3,
   "purpose": "稼働確認の内容",
   "kind": "probe",
   "expect": {
    "status": 200,
    "body_not_contains": [
     "internal"
    ]
   }
  },
  {
   "test_id": "t-index-menu",
   "feature": "export",
   "hypothesis": "h-export-authz",
   "role": "user_a",
   "method": "GET",
   "path": "/",
   "params": {},
   "cost": 1,
   "info_value": 0.3,
   "purpose": "ログイン後のメニュー構成を観測する",
   "kind": "navigation",
   "expect": {
    "status": 200
   }
  },
  {
   "test_id": "t-export-anon",
   "feature": "export",
   "hypothesis": "h-export-authz",
   "role": "anonymous",
   "method": "GET",
   "path": "/export/orders.csv",
   "params": {},
   "cost": 1,
   "info_value": 0.3,
   "purpose": "未ログインで拒否されるか(対照)",
   "kind": "control",
   "expect": {
    "status": [
     401,
     403
    ]
   },
   "inconclusive_statuses": []
  },
  {
   "test_id": "t-export-user",
   "feature": "export",
   "hypothesis": "h-export-authz",
   "role": "user_a",
   "method": "GET",
   "path": "/export/orders.csv",
   "params": {},
   "cost": 1,
   "info_value": 0.9,
   "purpose": "一般利用者が管理者向けCSVを取得できないか",
   "kind": "probe",
   "expect": {
    "status": [
     403,
     404
    ]
   },
   "unlocked_by": {
    "test_id": "t-index-menu",
    "body_contains": "/export"
   }
  }
 ],
 "normal_behavior": [
  "注文は所有者だけが参照できる",
  "CSV出力は管理者のみ",
  "検索語は表示時にエスケープされる",
  "/debug/version は公開情報のみ"
 ],
 "budget": {
  "max_requests": 7,
  "max_seconds": 60,
  "max_llm_calls": 8,
  "max_llm_input_chars": 8000
 },
 "stop_conditions": {
  "min_score": 0.05,
  "stop_when_all_hypotheses_resolved": true
 },
 "evidence": {
  "save": true
 },
 "out_of_scope": [],
 "notes": []
}

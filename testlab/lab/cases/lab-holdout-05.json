    "exposes_user_identifier"
   ]
  },
  {
   "hypothesis_id": "h-notes-xss",
   "feature": "notes",
   "rule_id": "XSS",
   "title": "メモ欄が入力を無害化して表示するか",
   "prior_value": 0.4,
   "severity_hint": "MEDIUM",
   "remediation": "現状のエスケープを維持する",
   "provides": [
    "xss_reflected"
   ]
  },
  {
   "hypothesis_id": "h-prefs-cookie",
   "feature": "prefs",
   "rule_id": "COOKIE_FLAGS",
   "title": "設定CookieにHttpOnlyが付くか",
   "prior_value": 0.3,
   "severity_hint": "LOW",
   "remediation": "現状の設定を維持する",
   "provides": [
    "cookie_script_readable"
   ]
  },
  {
   "hypothesis_id": "h-session-cookie",
   "feature": "session",
   "rule_id": "COOKIE_FLAGS",
   "title": "セッションCookieにHttpOnlyが付くか",
   "prior_value": 0.4,
   "severity_hint": "MEDIUM",
   "remediation": "Set-CookieにHttpOnlyを付ける",
   "provides": [
    "cookie_script_readable"
   ]
  },
  {
   "hypothesis_id": "h-sitemap-leak",
   "feature": "sitemap",
   "rule_id": "INFO_DISCLOSURE",
   "title": "サイトマップが内部パスを列挙しないか",
   "prior_value": 0.3,
   "severity_hint": "LOW",
   "remediation": "内部パスを載せない",
   "provides": [
    "reveals_internal_path"
   ]
  },
  {
   "hypothesis_id": "h-tools-authz",
   "feature": "tools",
   "rule_id": "BROKEN_ACCESS_CONTROL",
   "title": "内部ツールを認可なしで使えないか",
   "prior_value": 0.5,
   "severity_hint": "HIGH",
   "remediation": "運用者権限の検査を追加する",
   "provides": [
    "missing_function_authz"
   ]
  }
 ],
 "tests": [
  {
   "test_id": "t-admin",
   "feature": "admin",
   "hypothesis": "h-admin-authz",
   "role": "user_a",
   "method": "GET",
   "path": "/admin/console",
   "params": {},
   "cost": 1,
   "info_value": 0.6,
   "purpose": "一般利用者が管理コンソールを使えないか",
   "kind": "probe",
   "expect": {
    "status": [
     403,
     404
    ]
   }
  },
  {
   "test_id": "t-comment",
   "feature": "comments",
   "hypothesis": "h-comment-xss",
   "role": "anonymous",
   "method": "GET",
   "path": "/comments",
   "params": {
    "c": "<script>1</script>"
   },
   "cost": 1,
   "info_value": 0.6,
   "purpose": "スクリプト断片がそのまま反射されないか",
   "kind": "probe",
   "expect": {
    "status": 200,
    "body_not_contains": [
     "<script>1</script>"
    ]
   }
  },
  {
   "test_id": "t-invoice-own",
   "feature": "invoices",
   "hypothesis": "h-invoice-idor",
   "role": "user_a",
   "method": "GET",
   "path": "/invoices",
   "params": {
    "member": "user_a"
   },
   "cost": 1,
   "info_value": 0.2,
   "purpose": "自分の請求書が取得できる(対照)",
   "kind": "control",
   "expect": {
    "status": 200,
    "body_contains": [
     "inv-user_a"
    ]
   }
  },
  {
   "test_id": "t-invoice-cross",
   "feature": "invoices",
   "hypothesis": "h-invoice-idor",
   "role": "user_a",
   "method": "GET",
   "path": "/invoices",
   "params": {
    "member": "user_b"
   },
   "cost": 1,
   "info_value": 0.9,
   "purpose": "他人の請求書が拒否されるか",
   "kind": "probe",
   "expect": {
    "status": [
     403,
     404
    ],
    "body_not_contains": [
     "inv-user_b"
    ]
   }
  },
  {
   "test_id": "t-members",
   "feature": "members",
   "hypothesis": "h-member-list",
   "role": "anonymous",
   "method": "GET",
   "path": "/members.csv",
   "params": {},
   "cost": 1,
   "info_value": 0.5,
   "purpose": "会員一覧が未ログインで拒否されるか",
   "kind": "probe",
   "expect": {
    "status": [

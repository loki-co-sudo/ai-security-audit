   }
  },
  {
   "test_id": "t-session",
   "feature": "session",
   "hypothesis": "h-session-cookie",
   "role": "anonymous",
   "method": "GET",
   "path": "/session",
   "params": {},
   "cost": 1,
   "info_value": 0.6,
   "purpose": "セッションCookieのHttpOnly属性",
   "kind": "probe",
   "expect": {
    "status": 200,
    "header_contains": {
     "Set-Cookie": "HttpOnly"
    }
   }
  },
  {
   "test_id": "t-sitemap",
   "feature": "sitemap",
   "hypothesis": "h-sitemap-leak",
   "role": "anonymous",
   "method": "GET",
   "path": "/sitemap",
   "params": {},
   "cost": 1,
   "info_value": 0.5,
   "purpose": "サイトマップが内部パスを含まないか",
   "kind": "probe",
   "expect": {
    "status": 200,

  {
   "test_id": "t-tools",
   "feature": "tools",
   "hypothesis": "h-tools-authz",
   "role": "anonymous",
   "method": "GET",
   "path": "/internal/tools",
   "params": {},
   "cost": 1,
   "info_value": 0.8,
   "purpose": "内部ツールが認可なしで使えないか",
   "kind": "probe",
   "expect": {
    "status": [

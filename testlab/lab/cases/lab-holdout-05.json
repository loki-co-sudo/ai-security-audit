 "case_id": "lab-holdout-05",
 "split": "holdout",
 "title": "模擬ショップ(連鎖3種・保留)",
 "target_ref": "app:chainshop",
 "scope": {
  "allowed_hosts": [
   "127.0.0.1"
  ],
  "excluded_paths": [
   "/logout",
   "/admin/reset"
  ]
 },
 "side_effects_allowed": [
  "T1",
  "T2"
 ],
 "accounts": {
  "user_a": "cred:user_a",
  "user_b": "cred:user_b",
  "user_expired": "cred:user_expired"
 },
 "features": [
  {
   "feature_id": "admin",
   "title": "管理コンソール",
   "description": "管理者だけが利用できる"
  },
  {
   "feature_id": "comments",
   "title": "コメント",
   "description": "入力値は無害化して表示する"
  },
  {
   "feature_id": "invoices",
   "title": "請求書",
   "description": "所有者だけが参照できる"
  },
  {
   "feature_id": "members",
   "title": "会員一覧",
   "description": "会員の識別子を公開しない"
  },
  {
   "feature_id": "notes",
   "title": "メモ",
   "description": "入力値は無害化して表示する"
  },
  {
   "feature_id": "prefs",
   "title": "設定Cookie",
   "description": "Cookieはスクリプトから読めない"
  },
  {
   "feature_id": "session",
   "title": "セッション",
   "description": "セッションCookieはスクリプトから読めない"

 "hypotheses": [
  {
   "hypothesis_id": "h-admin-authz",
   "feature": "admin",
   "rule_id": "BROKEN_ACCESS_CONTROL",
   "title": "管理コンソールを一般利用者が使えないか",
   "prior_value": 0.6,
   "severity_hint": "HIGH",
   "remediation": "管理者権限の検査を維持する",
   "provides": [
    "missing_function_authz"
   ]
  },
  {
   "hypothesis_id": "h-comment-xss",
   "feature": "comments",
   "rule_id": "XSS",
   "title": "コメント欄が入力を無害化して表示するか",
   "prior_value": 0.4,
   "severity_hint": "MEDIUM",
   "remediation": "出力時にHTMLエスケープする",
   "provides": [
    "xss_reflected"
   ]
  },
  {
   "hypothesis_id": "h-invoice-idor",
   "feature": "invoices",
   "rule_id": "IDOR",
   "title": "他人の請求書を参照できないか",
   "prior_value": 0.7,
   "severity_hint": "HIGH",
   "remediation": "請求書取得時に所有者を照合する",
   "provides": [
    "read_other_user_object"
   ]
  },
  {
   "hypothesis_id": "h-member-list",
   "feature": "members",
   "rule_id": "INFO_DISCLOSURE",
   "title": "会員一覧が識別子を公開しないか",
   "prior_value": 0.3,
   "severity_hint": "LOW",
   "remediation": "一覧を非公開にする",

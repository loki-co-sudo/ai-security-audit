     403
    ]
   },
   "inconclusive_statuses": []
  },
  {
   "test_id": "t-note",
   "feature": "notes",
   "hypothesis": "h-notes-xss",
   "role": "anonymous",
   "method": "GET",
   "path": "/notes",
   "params": {
    "n": "<script>1</script>"
   },
   "cost": 1,
   "info_value": 0.5,
   "purpose": "スクリプト断片がそのまま反射されないか",
   "kind": "probe",
   "expect": {
    "status": 200,
    "body_not_contains": [
     "<script>1</script>"
    ]
   }
  },
  {
   "test_id": "t-prefs",
   "feature": "prefs",
   "hypothesis": "h-prefs-cookie",
   "role": "anonymous",
   "method": "GET",
   "path": "/prefs",
   "params": {},
   "cost": 1,
   "info_value": 0.4,
   "purpose": "設定CookieのHttpOnly属性",
   "kind": "probe",
   "expect": {
    "status": 200,
    "header_contains": {
